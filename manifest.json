{
  "manifest_version": 3,
  "name": "Window Router",
  "version": "1.4.1",
  "minimum_chrome_version": "111",
  "description": "Automatically route websites such as YouTube, X, LinkedIn, and GitHub to their assigned Chrome windows.",
  "permissions": ["alarms", "contextMenus", "storage", "tabs"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Window Router",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
